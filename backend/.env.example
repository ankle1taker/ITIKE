# ============================================================
# Server
# ============================================================
NODE_ENV=development
PORT=5000

# Trust proxy setting for req.ip and rate limiting:
# - "false"  → no proxy (local dev / direct connections)
# - "1"      → single proxy (Railway, Render, Fly, single Nginx)
# - "2"      → CDN + proxy (Cloudflare + Nginx)
# - "loopback" → trust only local reverse proxy
# REQUIRED in production.
TRUST_PROXY=false

# Frontend origin(s) for CORS. Comma-separated for multiple.
# REQUIRED in production.
FRONTEND_URL=http://localhost:3000

# ============================================================
# Database
# ============================================================
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/itike_db"

# ============================================================
# Auth
# ============================================================
JWT_SECRET="a-long-random-secret"
JWT_EXPIRES_IN=7d

# Ticket QR signing (separate from JWT_SECRET for rotation)
TICKET_QR_SECRET="a-long-random-secret-for-qr"

# ============================================================
# Payment
# ============================================================
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET="a-long-random-webhook-secret"

# ============================================================
# Notifications
# ============================================================
NOTIFICATION_PROVIDER=mock

# Africa's Talking (uncomment when ready to send real SMS)
# AFRICAS_TALKING_USERNAME=
# AFRICAS_TALKING_API_KEY=
# AFRICAS_TALKING_SENDER_ID=ITIKE

# ============================================================
# Logging / Error tracking
# ============================================================
LOG_LEVEL=info

# REQUIRED in production (startup will fail without it)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================
# Background services
# ============================================================
# Reconciler is opt-in; enable it in production
ENABLE_PAYMENT_RECONCILER=false

# Notification dispatcher is ON by default
# ENABLE_NOTIFICATION_DISPATCHER=true

# ============================================================
# Rate limiting (DEV/TEST ONLY — must be unset in production)
# ============================================================
# RATE_LIMIT_DISABLED=true

# ============================================================
# Admin bootstrap (used by scripts/*.js, not by the app at runtime)
# ============================================================
PLATFORM_ADMIN_NAME="Itike Platform Admin"
PLATFORM_ADMIN_PHONE=""
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""

# ============================================================
# Test credentials (used by Vitest — never used at runtime)
# ============================================================
TEST_COMPANY_ADMIN_PHONE=
TEST_COMPANY_ADMIN_PASSWORD=
TEST_PLATFORM_ADMIN_PHONE=
TEST_PLATFORM_ADMIN_PASSWORD=
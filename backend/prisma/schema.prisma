generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  COMPANY_ADMIN
  COMPANY_OPERATOR
  PLATFORM_ADMIN
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum BusStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum BusLayoutType {
  TWO_PLUS_TWO
  TWO_PLUS_ONE
  THREE_PLUS_TWO
  THREE_PLUS_ONE
  CUSTOM
}

enum SeatType {
  REGULAR
  PREMIUM
  VIP
  ACCESSIBLE
}

enum SeatStatus {
  ACTIVE
  INACTIVE
}

enum TripStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  ARRIVED
  CANCELLED
  DELAYED
}

enum TripSeatStatus {
  AVAILABLE
  HELD
  CONFIRMED
  BLOCKED
}

enum BookingStatus {
  HELD
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  EXPIRED
}

enum HoldStatus {
  ACTIVE
  EXPIRED
  RELEASED
  CONVERTED
}

enum CancellationStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

model Company {
  id                 String        @id @default(uuid())
  name               String
  registrationNumber String        @unique
  phone              String
  email              String?       @unique
  address            String?
  logoUrl            String?
  status             CompanyStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  users              User[]
  buses              Bus[]
  busLayouts         BusLayout[]
  trips              Trip[]
  cancellationPolicy CancellationPolicy?
  auditLogs          AuditLog[]

  @@index([status])
}

model User {
  id           String   @id @default(uuid())
  companyId    String?
  fullName     String
  email        String?  @unique
  phone        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  bookings  Booking[]  @relation("BookingCustomer")
  auditLogs AuditLog[] @relation("AuditActor")

  @@index([companyId])
  @@index([role])
  @@index([isActive])
}

model BusLayout {
  id            String        @id @default(uuid())
  companyId     String
  name          String
  code          String?
  layoutType    BusLayoutType @default(CUSTOM)
  rowCount      Int
  columnCount   Int
  configuration Json?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  buses   Bus[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, isActive])
}

model Bus {
  id                 String    @id @default(uuid())
  companyId          String
  layoutId           String?
  registrationNumber String
  manufacturer       String?
  model              String?
  busType            String
  capacity           Int
  status             BusStatus @default(ACTIVE)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  layout  BusLayout? @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  seats   Seat[]
  trips   Trip[]

  @@unique([companyId, registrationNumber])
  @@index([companyId])
  @@index([companyId, layoutId])
  @@index([status])
}

model Seat {
  id           String     @id @default(uuid())
  busId        String
  seatNumber   String
  rowNumber    Int?
  columnNumber Int?
  floorNumber  Int        @default(1)
  seatType     SeatType   @default(REGULAR)
  status       SeatStatus @default(ACTIVE)
  isBookable   Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  bus       Bus        @relation(fields: [busId], references: [id], onDelete: Cascade)
  tripSeats TripSeat[]

  @@unique([busId, seatNumber])
  @@index([busId])
  @@index([busId, status])
}

model Route {
  id          String   @id @default(uuid())
  origin      String
  destination String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stops RouteStop[]
  trips Trip[]

  @@index([origin, destination])
  @@index([isActive])
}

model RouteStop {
  id        String   @id @default(uuid())
  routeId   String
  name      String
  sequence  Int
  createdAt DateTime @default(now())

  route    Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([routeId, sequence])
  @@index([routeId])
}

model Trip {
  id            String     @id @default(uuid())
  companyId     String
  routeId       String
  busId         String
  departureTime DateTime
  arrivalTime   DateTime?
  basePrice     Decimal    @db.Decimal(12, 2)
  status        TripStatus @default(SCHEDULED)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  route   Route   @relation(fields: [routeId], references: [id], onDelete: Restrict)
  bus     Bus     @relation(fields: [busId], references: [id], onDelete: Restrict)

  tripSeats TripSeat[]
  bookings  Booking[]

  @@index([companyId])
  @@index([routeId])
  @@index([busId])
  @@index([departureTime])
  @@index([status])
}

model TripSeat {
  id        String         @id @default(uuid())
  tripId    String
  seatId    String
  status    TripSeatStatus @default(AVAILABLE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seat Seat @relation(fields: [seatId], references: [id], onDelete: Restrict)

  bookingSeats BookingSeat[]
  bookingHolds BookingHold[]

  @@unique([tripId, seatId])
  @@index([tripId, status])
  @@index([seatId])
}

model Booking {
  id            String        @id @default(uuid())
  bookingNumber String        @unique
  tripId        String
  customerId    String
  dropoffStopId String?
  status        BookingStatus @default(HELD)
  totalAmount   Decimal       @db.Decimal(12, 2)
  expiresAt     DateTime?
  termsSnapshot Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Restrict)
  customer    User       @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  dropoffStop RouteStop? @relation(fields: [dropoffStopId], references: [id], onDelete: Restrict)

  passengers   BookingPassenger[]
  bookingSeat  BookingSeat[]
  holds        BookingHold[]
  payment      Payment?
  ticket       Ticket?
  cancellation Cancellation?

  @@index([tripId, status])
  @@index([customerId])
  @@index([expiresAt])
}

model BookingPassenger {
  id        String   @id @default(uuid())
  bookingId String
  fullName  String
  phone     String
  idType    String?
  idNumber  String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  seats BookingSeat[]

  @@index([bookingId])
}

model BookingSeat {
  id          String   @id @default(uuid())
  bookingId   String
   tripSeatId  String
  passengerId String
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tripSeat  TripSeat         @relation(fields: [tripSeatId], references: [id], onDelete: Restrict)
  passenger BookingPassenger @relation(fields: [passengerId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([tripSeatId])
  @@index([passengerId])
}

model BookingHold {
  id         String     @id @default(uuid())
  bookingId  String
  tripSeatId String
  status     HoldStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  releasedAt DateTime?

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tripSeat TripSeat @relation(fields: [tripSeatId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([tripSeatId, status])
  @@index([expiresAt])
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod
  provider          String
  providerReference String?       @unique
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status])
}

model Ticket {
  id           String       @id @default(uuid())
  bookingId    String       @unique
  ticketNumber String       @unique
  qrCodeValue  String       @unique
  status       TicketStatus @default(ACTIVE)
  issuedAt     DateTime     @default(now())
  usedAt       DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status])
}

model CancellationPolicy {
  id                 String   @id @default(uuid())
  companyId          String   @unique
  moreThan24HoursPct Decimal  @db.Decimal(5, 2)
  twelveTo24HoursPct Decimal  @db.Decimal(5, 2)
  lessThan12HoursPct Decimal  @db.Decimal(5, 2)
  afterDeparturePct  Decimal  @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Cancellation {
  id           String             @id @default(uuid())
  bookingId    String             @unique
  status       CancellationStatus @default(REQUESTED)
  reason       String?
  refundAmount Decimal            @db.Decimal(12, 2)
  requestedAt  DateTime           @default(now())
  processedAt  DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actor   User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
}
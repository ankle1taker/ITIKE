{
  "name": "itike-backend",
  "type": "module",
  "version": "1.0.0",
  "description": "Backend API for the Itike bus ticket reservation platform",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=./src src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "admin:create": "node scripts/create-platform-admin.js",
    "company-admin:create": "node scripts/create-company-admin.js",
    "debug:booking": "node scripts/debug-booking.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "itike",
    "bus",
    "reservation",
    "ticketing"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^11.12.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
